rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Items: Anyone can view catalog, authenticated users can write
    match /items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Borrow requests: Read and write for application users
    match /borrow_requests/{requestId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
